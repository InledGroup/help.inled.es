---
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import type { DocsTree } from "../lib/tree";

interface Props {
  tree: DocsTree;
  title: string;
  description: string;
  trail?: string[];
  toc?: string;
  jsonLd?: object | object[];
}

const { tree, title, description, trail = [], toc, jsonLd = [] } = Astro.props;
const activePath = Astro.url.pathname;
const isHome = trail.length === 0 && activePath === "/";
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="layout">
    <Sidebar tree={tree} currentPath={activePath} />

    <main class="main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open side menu" aria-expanded="false" aria-controls="sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        <div class="topbar-actions">
          <button class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark mode" title="Light / dark mode">
            <span class="sun-moon">
              <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </span>
          </button>
        </div>
      </header>

      <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

      <div class="doc-area">
        <article class="doc">
          {!isHome && <Breadcrumb trail={trail} title={title} />}
          <div class="prose">
            <slot />
          </div>

          <section class="community-cta" aria-label="Community">
            <p>Any doubts or questions?</p>
            <p class="community-cta-title">Join the Inled community</p>
            <div class="community-cta-actions">
              <a class="btn" href="https://link.inled.es/discord" rel="noopener"><span>Discord</span></a>
              <a class="btn" href="https://link.inled.es/telegram" rel="noopener"><span>Telegram</span></a>
            </div>
          </section>

          <nav class="footer-nav">
            <a class="edit-link" href="https://github.com/InledGroup/help.inled.es" rel="noopener">Found an issue? Help us improve it on GitHub →</a>
          </nav>
        </article>

        {toc && (
          <aside class="right-toc" id="right-toc" aria-label="On this page">
            <h2>On this page</h2>
            <div class="toc-body" set:html={toc} />
          </aside>
        )}
      </div>

      <footer class="footer">
        <p>Get in touch with us!</p>
        <p class="footer-links">
          <a href="https://inled.es" rel="noopener">inled.es</a> ·
          <a href="https://github.com/InledGroup/help.inled.es" rel="noopener">GitHub</a> ·
          <a href="https://link.inled.es/discord" rel="noopener">Discord</a> ·
          <a href="https://link.inled.es/telegram" rel="noopener">Telegram</a>
        </p>
      </footer>
    </main>
  </div>

  <script>
    import "../scripts/ui.js";
  </script>
</Base>
